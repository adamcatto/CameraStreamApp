<Window x:Class="CameraStream.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CameraStream.Windows.Views"
        Title="Camera Stream" Height="720" Width="1100"
        Icon="Assets/icon.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ToolBar Grid.Row="0">
                    <Button Content="+" FontSize="16" Command="{Binding AddWorkspaceCommand}" ToolTip="Add workspace" />
                </ToolBar>

                <ListBox Grid.Row="1" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}"
                         DisplayMemberPath="Name" Margin="5" />

                <Button Grid.Row="2" Content="Settings" Command="{Binding ShowSettingsCommand}" Margin="5" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                <TextBlock Text="{Binding SelectedWorkspace.Name}" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" Visibility="{Binding IsWorkspaceEditorVisible, Converter={StaticResource BoolToVis}}" />
                <Button Content="Delete workspace" Command="{Binding DeleteWorkspaceCommand}" Margin="10,0,0,0"
                        Visibility="{Binding IsWorkspaceEditorVisible, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="Streaming" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                           Visibility="{Binding IsStreamGridVisible, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                           Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}" />

                <Button Content="Open cluster shell" Command="{Binding OpenClusterShellCommand}" Margin="10,0,0,0" />
                <Button Content="Start streaming" Command="{Binding StartStreamingCommand}" Margin="10,0,0,0" />
                <Button Content="Stop" Command="{Binding StopStreamingCommand}" Margin="10,0,0,0" />
            </StackPanel>

            <ContentControl Grid.Row="1">
                <Grid>
                    <views:WorkspaceEditorView DataContext="{Binding SelectedWorkspace}">
                        <views:WorkspaceEditorView.Visibility>
                            <Binding Path="IsWorkspaceEditorVisible" RelativeSource="{RelativeSource AncestorType=Window}"
                                     Converter="{StaticResource BoolToVis}" />
                        </views:WorkspaceEditorView.Visibility>
                    </views:WorkspaceEditorView>
                    <views:StreamGridView DataContext="{Binding}"
                                          Visibility="{Binding IsStreamGridVisible, Converter={StaticResource BoolToVis}}" />
                    <views:SettingsView DataContext="{Binding}"
                                        Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </ContentControl>

            <StatusBar Grid.Row="2">
                <TextBlock Text="{Binding Status}" Margin="5" />
            </StatusBar>
        </Grid>
    </Grid>
</Window>
