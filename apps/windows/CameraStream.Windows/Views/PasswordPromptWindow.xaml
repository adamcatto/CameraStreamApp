<Window x:Class="CameraStream.Windows.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credentials" SizeToContent="WidthAndHeight" ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <StackPanel Margin="20" Width="360">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />

        <TextBlock Text="Shared password for camera accounts" />
        <PasswordBox x:Name="CameraPasswordBox" Margin="0,0,0,10" />

        <StackPanel x:Name="JumpHostPanel" Visibility="Collapsed">
            <TextBlock x:Name="JumpHostLabel" Text="Jump host password" />
            <PasswordBox x:Name="JumpPasswordBox" Margin="0,0,0,10" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,5,0" />
            <Button Content="Start" IsDefault="True" Click="Start_Click" />
        </StackPanel>
    </StackPanel>
</Window>
