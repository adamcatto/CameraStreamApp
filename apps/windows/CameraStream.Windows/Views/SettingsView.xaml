<UserControl x:Class="CameraStream.Windows.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CameraStream.Windows.Views"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel Margin="10">
            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Rename cameras and manage session credentials here. Passwords are not saved to disk unless you are using a profile bundle."
                       Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock Text="{Binding BundledToolsStatus}" FontSize="10" Foreground="Gray" Margin="0,0,0,10" />

            <ItemsControl ItemsSource="{Binding CredentialStore.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                            <local:SecureTextBox Grid.Column="1" Password="{Binding Password, Mode=TwoWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Clear all session credentials" Command="{Binding ClearCredentialsCommand}"
                    Margin="0,10,0,0" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
