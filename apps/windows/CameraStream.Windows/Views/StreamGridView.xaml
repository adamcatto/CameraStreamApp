<UserControl x:Class="CameraStream.Windows.Views.StreamGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:CameraStream.Windows.Views"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <ItemsControl ItemsSource="{Binding StreamPlayers}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Width="360" Height="240" Margin="5">
                        <Grid>
                            <views:VideoStreamControl DataContext="{Binding}" />
                            <TextBlock Text="{Binding Name}" Foreground="White" Background="Black"
                                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Padding="4,2" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
