<UserControl x:Class="CameraStream.Windows.Views.StreamGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:CameraStream.Windows.Views"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- One labelled slider row inside the capture-settings panel. -->
        <Style x:Key="CaptureLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B7C3CC" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="CaptureValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9FB0BB" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <!-- Small translucent overlay button for the tile controls. -->
        <Style x:Key="TileControlButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- A grid tile is a fixed size; the focused tile fills the viewport. -->
        <Style x:Key="TileBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Width" Value="360" />
            <Setter Property="Height" Value="240" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsFocused, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Width" Value="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                    <Setter Property="Height" Value="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding DisplayedPlayers}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource TileBorder}">
                        <Grid>
                            <views:VideoStreamControl DataContext="{Binding}" />
                            <TextBlock Text="{Binding Name}" Foreground="White" Background="Black"
                                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Padding="4,2" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4">
                                <Button Content="&#x2922;" Style="{StaticResource TileControlButton}"
                                        ToolTip="Expand this camera"
                                        Visibility="{Binding DataContext.IsGridMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.FocusCameraCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="&#x2921;" Style="{StaticResource TileControlButton}"
                                        ToolTip="Show all cameras"
                                        Visibility="{Binding DataContext.IsFocused, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.ShowAllCamerasCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="&#x26F6;" Style="{StaticResource TileControlButton}"
                                        ToolTip="Toggle full screen"
                                        Command="{Binding DataContext.ToggleFullScreenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </StackPanel>
                            <Button x:Name="SettingsButton" Content="&#x2699;"
                                    Command="{Binding ToggleSettingsCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                    Width="26" Height="26" FontSize="14" Foreground="White"
                                    Background="#99000000" BorderThickness="0" ToolTip="Adjust capture settings" />
                            <Popup IsOpen="{Binding SettingsOpen, Mode=TwoWay}" StaysOpen="False"
                                   Placement="Bottom" PlacementTarget="{Binding ElementName=SettingsButton}"
                                   AllowsTransparency="True" HorizontalOffset="-294">
                                <Border Background="#141A20" BorderBrush="#333E47" BorderThickness="1"
                                        Padding="12" Width="320">
                                    <StackPanel>
                                        <TextBlock Text="Capture settings" Foreground="White"
                                                   FontWeight="Bold" Margin="0,0,0,8" />

                                        <StackPanel Margin="0,3">
                                            <DockPanel>
                                                <TextBlock Text="Shutter (µs, 0 = auto)" Style="{StaticResource CaptureLabel}" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding Settings.Shutter, StringFormat={}{0:0}}" Style="{StaticResource CaptureValue}" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="200000" SmallChange="500" LargeChange="5000"
                                                    Value="{Binding Settings.Shutter, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,3">
                                            <DockPanel>
                                                <TextBlock Text="Gain" Style="{StaticResource CaptureLabel}" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding Settings.Gain, StringFormat={}{0:0.##}}" Style="{StaticResource CaptureValue}" />
                                            </DockPanel>
                                            <Slider Minimum="1" Maximum="64" SmallChange="0.5" Value="{Binding Settings.Gain, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,3">
                                            <DockPanel>
                                                <TextBlock Text="AWB red gain (0 = auto)" Style="{StaticResource CaptureLabel}" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding Settings.AwbRedGain, StringFormat={}{0:0.#}}" Style="{StaticResource CaptureValue}" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="8" SmallChange="0.1" Value="{Binding Settings.AwbRedGain, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,3">
                                            <DockPanel>
                                                <TextBlock Text="AWB blue gain (0 = auto)" Style="{StaticResource CaptureLabel}" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding Settings.AwbBlueGain, StringFormat={}{0:0.#}}" Style="{StaticResource CaptureValue}" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="8" SmallChange="0.1" Value="{Binding Settings.AwbBlueGain, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,3">
                                            <DockPanel>
                                                <TextBlock Text="Brightness" Style="{StaticResource CaptureLabel}" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding Settings.Brightness, StringFormat={}{0:0.##}}" Style="{StaticResource CaptureValue}" />
                                            </DockPanel>
                                            <Slider Minimum="-1" Maximum="1" SmallChange="0.05" Value="{Binding Settings.Brightness, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,3">
                                            <DockPanel>
                                                <TextBlock Text="Contrast" Style="{StaticResource CaptureLabel}" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding Settings.Contrast, StringFormat={}{0:0.##}}" Style="{StaticResource CaptureValue}" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="2" SmallChange="0.05" Value="{Binding Settings.Contrast, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,3">
                                            <DockPanel>
                                                <TextBlock Text="Saturation" Style="{StaticResource CaptureLabel}" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding Settings.Saturation, StringFormat={}{0:0.##}}" Style="{StaticResource CaptureValue}" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="2" SmallChange="0.05" Value="{Binding Settings.Saturation, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,3">
                                            <DockPanel>
                                                <TextBlock Text="Sharpness" Style="{StaticResource CaptureLabel}" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding Settings.Sharpness, StringFormat={}{0:0.##}}" Style="{StaticResource CaptureValue}" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="2" SmallChange="0.05" Value="{Binding Settings.Sharpness, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,3">
                                            <DockPanel>
                                                <TextBlock Text="EV compensation" Style="{StaticResource CaptureLabel}" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding Settings.Ev, StringFormat={}{0:0.##}}" Style="{StaticResource CaptureValue}" />
                                            </DockPanel>
                                            <Slider Minimum="-10" Maximum="10" SmallChange="0.5" Value="{Binding Settings.Ev, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,3">
                                            <DockPanel>
                                                <TextBlock Text="Frame rate" Style="{StaticResource CaptureLabel}" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding Settings.Framerate, StringFormat={}{0:0}}" Style="{StaticResource CaptureValue}" />
                                            </DockPanel>
                                            <Slider Minimum="1" Maximum="120" SmallChange="1" Value="{Binding Settings.Framerate, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                            <Button Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,8,0" Padding="10,3" />
                                            <Button Content="Apply" Command="{Binding ApplyCommand}"
                                                    IsEnabled="{Binding CanApply}" Padding="10,3" />
                                        </StackPanel>
                                        <TextBlock Text="Applying relaunches this camera's encoder, so its video reconnects briefly."
                                                   Foreground="#7F8D97" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
