{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camera-stream.local/schemas/workspaces.schema.json",
  "title": "Camera Stream workspaces",
  "type": "array",
  "items": {
    "$ref": "#/$defs/workspace"
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "host", "username", "port"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1, "default": "pi" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 8888 }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "cameras"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "jumpHost": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "cameras": {
          "type": "array",
          "items": { "$ref": "#/$defs/camera" }
        }
      }
    }
  }
}
